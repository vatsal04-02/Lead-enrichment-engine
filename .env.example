# Copy to .env (never commit it). Every setting is optional; defaults are conservative.
LE_DATABASE_URL=postgresql://enrich@127.0.0.1:55432/enrich

# --- who you are to the websites you fetch (REQUIRED for live crawling) ---
LE_USER_AGENT="YourCompanyBot/1.0 (+https://your.site/bot; ops@your.site)"

# --- concurrency (benchmark before raising) ---
LE_GLOBAL_CONCURRENCY=8           # companies in flight per worker process
LE_PER_DOMAIN_CONCURRENCY=2
LE_PER_DOMAIN_MIN_DELAY=0.5       # seconds between request starts to one host
LE_QUEUE_SIZE=32                  # bounded buffer between DB claimer and workers
LE_HTTP_MAX_CONNECTIONS=50

# --- timeouts / retries ---
LE_CONNECT_TIMEOUT=5
LE_READ_TIMEOUT=10
LE_TOTAL_TIMEOUT=20
LE_HTTP_MAX_RETRIES=2
LE_MAX_RESPONSE_BYTES=2000000
LE_MAX_REDIRECTS=5

# --- page limits ---
LE_MAX_PAGES_PER_COMPANY=4
LE_MAX_PAGES_PER_DOMAIN=6

# --- tier 4: browser (needs: pip install '.[browser]' and a chromium build) ---
LE_BROWSER_ENABLED=true
LE_BROWSER_CONCURRENCY=1
# LE_BROWSER_EXECUTABLE=/opt/pw-browsers/chromium

# --- tier 5: LLM (needs: pip install '.[ai]'); disabled unless LE_AI_PROVIDER is set ---
# LE_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...      # read by the Anthropic SDK; never logged or returned by the API
# LE_AI_MODEL=claude-haiku-5-5
# LE_AI_PRICE_IN_PER_MTOK=0.10      # USD per million tokens — set to YOUR model's current price
# LE_AI_PRICE_OUT_PER_MTOK=0.50

# --- freshness (days). Per field: LE_FRESHNESS_DAYS="email=60,address=180" ---
LE_DEFAULT_FRESHNESS_DAYS=90
LE_NOT_FOUND_RETRY_DAYS=14

# --- jobs ---
LE_MAX_CONCURRENT_JOBS=2
LE_MAX_COMPANIES_PER_JOB=100000
LE_MAX_CSV_BYTES=200000000
LE_ITEM_MAX_ATTEMPTS=3
LE_JOB_LEASE_SECONDS=60

# --- default per-job budgets (0 = unlimited) ---
LE_BUDGET_PAGES=100000
LE_BUDGET_AI_CALLS=1000
LE_BUDGET_BROWSER_OPS=200
LE_BUDGET_SECONDS=21600
LE_BUDGET_EST_COST_USD=10.0

# --- cost model (all USD figures are ESTIMATES built from these) ---
LE_COST_PER_HTTP_REQUEST_USD=0
LE_BROWSER_COST_PER_SECOND_USD=0

# --- API ---
# LE_API_TOKEN=change-me            # if set, all /v1 routes require "Authorization: Bearer <token>"
